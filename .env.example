ENV=dev
PORT=8080

# BitAuth (required to start the edge)
BITAUTH_ISSUER=https://auth.trinit.is/
BITAUTH_CLIENT_ID=
BITAUTH_CLIENT_SECRET=
BITAUTH_REDIRECT_URL=http://127.0.0.1:8080/callback
BITAUTH_LOGOUT_REDIRECT_URL=http://localhost:8080/

# Optional: app mint on /app/me (all three required together)
SPACETIMEAUTH_ISSUER=https://auth.spacetimedb.com/oidc
SPACETIMEAUTH_CLIENT_ID=
SPACETIMEAUTH_CLIENT_SECRET=
SPACETIMEAUTH_REDIRECT_URL=http://127.0.0.1:8080/auth/spacetimeauth/callback

# Local SpacetimeDB (these are also the edge defaults)
STDB_HOST=http://127.0.0.1:3000
STDB_DATABASE=stelofinance
