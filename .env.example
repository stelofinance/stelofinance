ENV=dev
PORT=8080

# OIDC login (required to start the edge). Local dev uses the dev-oidc
# provider (`src/dev_oidc.rs`), which debug builds of the edge start on :9090:
# sign in as any username.
# The issuer must match USER_OIDC_ISSUER in spacetime.json, and the client
# id is the audience the module expects. dev-oidc ignores the secret.
# To use a real provider instead, set its issuer, client and secret here and
# change USER_OIDC_ISSUER in spacetime.json to match.
OIDC_ISSUER=http://127.0.0.1:9090/
OIDC_CLIENT_ID=nintron-stelofinance
OIDC_CLIENT_SECRET=dev
OIDC_REDIRECT_URL=http://127.0.0.1:8080/auth/oidc/callback
# Optional: shown as "Log in with …" / "Signed in with …".
OIDC_PROVIDER_NAME=dev-oidc

# Local SpacetimeDB (these are also the edge defaults)
STDB_HOST=http://127.0.0.1:3000
STDB_DATABASE=stelofinance
